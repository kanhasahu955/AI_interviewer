# Production env for bakerywala.cloud split deploy
# Copy to backend/.env on the VPS — never commit real values.

APP_ENV=production
APP_DEBUG=false
SECRET_KEY=change-me-to-a-long-random-string

# Frontend origin (CORS + cookies)
CORS_ORIGINS=https://iweb.bakerywala.cloud

DB_PROVIDER=snowflake
# SNOWFLAKE_ACCOUNT=...
# SNOWFLAKE_USER=...
# SNOWFLAKE_PASSWORD=...
# SNOWFLAKE_DATABASE=...
# SNOWFLAKE_SCHEMA=...
# SNOWFLAKE_WAREHOUSE=...
# SNOWFLAKE_ROLE=...

REDIS_URL=redis://redis:6379/0
USE_REDIS_QUEUE=true

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

OPENAI_API_KEY=
GROQ_API_KEY=

SIMLI_ENABLED=true
SIMLI_API_KEY=
SIMLI_FACE_ID=

LIVEPORTRAIT_ENABLED=false

PINECONE_API_KEY=
PINECONE_INDEX_NAME=
