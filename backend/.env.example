# Copy to .env and fill in real values. Never commit .env to git.

OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
HUGGINGFACE_API_KEY=
SERPER_API_KEY=
TAVILY_API_KEY=

LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=interviewer-ai
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

REDIS_URL=redis://localhost:6379/0
USE_REDIS_QUEUE=true

STORAGE_TYPE=local
STORAGE_PATH=storage

APP_ENV=development
APP_DEBUG=false
SECRET_KEY=change-me-in-prod
CORS_ORIGINS=*

DB_PROVIDER=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_DB=interviewer_ai

# Or use Snowflake (set DB_PROVIDER=snowflake)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_ROLE=
SNOWFLAKE_LEGACY_LOCATOR=false
SNOWFLAKE_CLOUD=aws

PINECONE_API_KEY=
PINECONE_ENV=us-east-1
PINECONE_INDEX_NAME=interviewer-ai
PINECONE_NAMESPACE=default

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

SIMLI_ENABLED=false
SIMLI_API_KEY=
SIMLI_FACE_ID=

LIVEPORTRAIT_ENABLED=false
LIVEPORTRAIT_REPO=

OTP_MODE=email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
